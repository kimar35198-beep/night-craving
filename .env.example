# Server port (default: 3000)
PORT=3000

# Secret used to sign login sessions. Set a long random value in production
# so sessions survive server restarts.
SESSION_SECRET="replace-with-a-long-random-secret"

# Password for the kitchen admin panel at /admin.
ADMIN_PASSWORD="change-this-admin-password"

# Optional Twilio credentials. When both are set, the demo OTP preview is hidden.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""

# Optional public URL of the deployed site.
# APP_URL="https://your-site.example.com"
